# ============================================================
# CONFIGURACIÓN DEL BACKEND
# Copiar este archivo como .env y completar los valores
# ============================================================

# ---- Supabase ----
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=tu_service_role_key_aqui
SUPABASE_ANON_KEY=tu_anon_key_aqui

# ---- Base de datos PostgreSQL ----
# La encontrás en Supabase > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.TU-PROYECTO.supabase.co:5432/postgres

# ---- JWT ----
JWT_SECRET=cambiar_esto_por_una_clave_muy_larga_y_aleatoria_min_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- CORS ----
# Dominios del frontend separados por coma
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000,https://tu-app.netlify.app

# ---- Storage ----
STORAGE_BUCKET=ticket-files
MAX_FILE_SIZE_MB=25

# ---- Server ----
ENVIRONMENT=development
LOG_LEVEL=info
